# =============================================================================
# Classroom Attention & Fatigue Detection System — Environment Configuration
# =============================================================================
# DO NOT COMMIT PRODUCTION SECRETS TO VERSION CONTROL.
# Copy this file to .env and replace placeholders with production values.

# -----------------------------------------------------------------------------
# 1. Server & Security Settings (SYS-10, SYS-14, APP-26, APP-27)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Non-Negotiable Privacy Mode Default: MUST be true in production.
# When true, /ws/video is strictly disabled (rejects connections with code 4403).
# Telemetry only; no raw video or face crops are persisted or streamed.
PRIVACY_MODE=true

# JWT Signing Key: Replace with a cryptographically secure random string (≥ 32 chars).
# Example generator: `openssl rand -hex 32`
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins: Restrict to trusted frontends (Operator Console, Mobile)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Rate Limiting (APP-26): Max failed attempts before temporary lockout (HTTP 429)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300

# -----------------------------------------------------------------------------
# 2. Database Connection (SYS-12, APP-12, CON §7)
# -----------------------------------------------------------------------------
# SQLite (Local Dev / Edge): sqlite:///./app.db
# PostgreSQL (Production / Cloud): postgresql://user:password@localhost:5432/classroom_monitoring
DATABASE_URL=sqlite:///./app.db

# Data Retention Policy: Auto-purge observations older than specified days
RETENTION_DAYS=180

# -----------------------------------------------------------------------------
# 3. AI Pipeline & Telemetry Thresholds (CON §5, CON §6)
# -----------------------------------------------------------------------------
TARGET_FPS=20
TELEMETRY_HZ=2
MIN_CONFIDENCE=0.80
WINDOW_FRAMES=30
STATUS_HYSTERESIS_S=3.0
FATIGUE_PERSIST_S=45.0
DISTRACTION_PERSIST_S=30.0
ALERT_COOLDOWN_S=300.0
OBSERVATION_INTERVAL_S=5
CAMERA_TIMEOUT_S=10.0
AI_HEARTBEAT_TIMEOUT_S=10.0

# -----------------------------------------------------------------------------
# 4. Model Weights Paths (Decision D2)
# -----------------------------------------------------------------------------
DROWSINESS_MODEL_PATH=backend/models/drowsiness/
EXPRESSION_MODEL_PATH=backend/models/expression/
